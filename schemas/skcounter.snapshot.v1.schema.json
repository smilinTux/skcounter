{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smilinTux/skcounter/schemas/skcounter.snapshot.v1.schema.json",
  "title": "SKCounter aggregate snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "idempotency_key",
    "measurement_lane",
    "node_id",
    "principal_id",
    "collector",
    "observed_at",
    "bucket_timezone",
    "window",
    "source_state_digest",
    "aggregates",
    "payload_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "skcounter.snapshot.v1"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "measurement_lane": {
      "enum": ["harness_reported", "gateway_observed"]
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "facade_version", "backend", "backend_version"],
      "properties": {
        "product": {
          "const": "skcounter"
        },
        "facade_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "backend": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "backend_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "bucket_timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "source_state_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "aggregates": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/aggregate"
      }
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view", "bucket_start", "tokens"],
      "properties": {
        "view": {
          "enum": ["models", "daily", "hourly", "agents", "workspaces", "sessions", "tasks", "time_metrics"]
        },
        "bucket_start": {
          "type": "string",
          "format": "date-time"
        },
        "client": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "workspace_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "workspace_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "session_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "task_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "tokens": {
          "$ref": "#/$defs/tokens"
        },
        "message_count": {
          "type": "integer",
          "minimum": 0
        },
        "cost": {
          "$ref": "#/$defs/cost"
        },
        "performance": {
          "$ref": "#/$defs/performance"
        },
        "activity": {
          "$ref": "#/$defs/activity"
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "output",
        "cache_read",
        "cache_write",
        "reasoning",
        "total"
      ],
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency", "estimated", "pricing_revision"],
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "const": "USD"
        },
        "estimated": {
          "type": "boolean"
        },
        "pricing_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "timed_tokens", "sample_count", "token_coverage"],
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "timed_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "token_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ms_per_1k_tokens": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_seconds", "longest_continuous_seconds", "max_concurrent"],
      "properties": {
        "active_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "longest_continuous_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "max_concurrent": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
