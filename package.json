{
  "name": "@smilintux/skcounter",
  "version": "0.2.0",
  "private": true,
  "description": "Governed, provider-neutral token usage accounting for the SK fleet",
  "type": "module",
  "bin": {
    "skcounter": "./bin/skcounter.mjs"
  },
  "files": [
    "bin",
    "src",
    "edge/*.py",
    "edge/*.sh",
    "services/*.py",
    "services/*.mjs",
    "deploy/systemd",
    "scripts/*.sh",
    "schemas",
    "docs",
    "LICENSE",
    "SOP.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "scripts": {
    "test": "node --test && python3 -m unittest discover -s test_py",
    "test:package": "npm pack --dry-run",
    "check": "npm test && npm run test:package"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tokscale/cli": "4.13.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smilinTux/skcounter.git"
  }
}
